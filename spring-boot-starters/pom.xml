<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.trionesdev.csi</groupId>
        <artifactId>csi-spring-boot</artifactId>
        <version>3.0.5-SNAPSHOT</version>
    </parent>

    <artifactId>spring-boot-starters</artifactId>
    <name>Triones:CSI:Starters</name>
    <packaging>pom</packaging>

    <modules>
        <module>spring-boot-starter-csi-aliyun</module>
        <module>spring-boot-starter-csi-aliyun-oss</module>
        <module>spring-boot-starter-csi-aliyun-sms</module>

        <module>spring-boot-starter-csi-huaweicloud</module>
        <module>spring-boot-starter-csi-huaweicloud-obs</module>
        <module>spring-boot-starter-csi-huaweicloud-sms</module>

        <module>spring-boot-starter-csi-qiniu</module>
        <module>spring-boot-starter-csi-qiniu-kudo</module>

        <module>spring-boot-starter-csi-azure</module>
        <module>spring-boot-starter-csi-azure-blob</module>


        <module>spring-boot-starter-csi-tencentcloud-ses</module>
        <module>spring-boot-starter-csi-tencentcloud</module>
        <module>spring-boot-starter-csi-tencentcloud-cos</module>
        <module>spring-boot-starter-csi-tencentcloud-sms</module>
        <module>spring-boot-starter-csi-tencentcloud-ocr</module>

        <module>spring-boot-starter-csi-selfhosted</module>
        <module>spring-boot-starter-csi-minio</module>
        <module>spring-boot-starter-csi-rustfs</module>
        <module>spring-boot-starter-csi-localstorage</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.trionesdev.csi</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>